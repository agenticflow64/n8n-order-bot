# Скопируйте в .env и заполните. .env НЕ коммитится.

# OpenRouter (обязателен для LLM-извлечения)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Только бесплатные модели (:free)
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Telegram (опционально: для реального бота вместо эмулятора)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Резервный LLM-провайдер (GLM)
GLM_API_KEY=
GLM_BASE_URL=
GLM_MODEL=
