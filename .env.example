# Скопируйте в .env и заполните. .env НЕ коммитится.

# OpenRouter (обязателен для LLM-извлечения)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Только бесплатные модели (:free)
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Telegram (опционально: для реального бота вместо эмулятора)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# Сеть n8n (bridge по умолчанию). host — если IPv4 docker-сети блокируется OpenRouter (403)
N8N_NETWORK_MODE=host
# Как n8n обращается к backend: bridge -> http://backend:8000, host -> http://localhost:8000
BACKEND_BASE_URL=http://localhost:8000
