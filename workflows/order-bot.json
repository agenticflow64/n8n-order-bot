    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Приветствие на /start и /help: LLM не нужен.\n// Текст — копия WELCOME_TEXT из backend/app/bot_replies.py, синхронизируйте вручную.\nconst WELCOME_TEXT = [\n  'Привет 👋 Я оформляю заказы в один шаг: пишете как удобно, я раскладываю на детали, даю номер и передаю в работу.',\n  '',\n  'Например, хватит такого:',\n  '• надо стрижку собаке на выходные, телефон 89161234567',\n  '• ноут асус не включается, я Дима, можете вечером?',\n  '• срочно нужен мастер, кран потёк, адрес Ленина 5',\n  '',\n  'Пишите заказ прямо сюда, своим языком: с опечатками тоже сработает. Через несколько секунд пришлю сводку и две кнопки, подтвердить или отменить.',\n].join('\\n');\n\nconst norm = $input.first().json;\nreturn [{ json: {\n  reply: WELCOME_TEXT,\n  order_id: null,\n  ok: true,\n  escalated: false,\n  show_buttons: false,\n  debug: { welcome: true },\n  source: norm.source,\n  chat_id: norm.chat_id,\n  name: norm.name,\n} }];"
      },
