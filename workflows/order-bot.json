        "jsCode": "// Нажатие inline-кнопки: callback_data вида confirm:{id} / cancel:{id}.\n// Логика — копия parse_callback_data из backend/app/bot_replies.py.\nconst u = $input.first().json;\nconst cq = u.callback_query || {};\nconst m = String(cq.data || '').match(/^(confirm|cancel):(\\d+)$/);\nreturn [{ json: {\n  action: m ? m[1] : 'unknown',\n  order_id: m ? Number(m[2]) : null,\n  cbq_id: cq.id,\n  chat_id: cq.message && cq.message.chat ? String(cq.message.chat.id) : null,\n  message_id: cq.message ? cq.message.message_id : null,\n} }];"
