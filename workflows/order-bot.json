        "mode": "runOnceForAllItems",
        "jsCode": "// Ответ на нажатие кнопки: alert -> answerCallbackQuery, edit -> editMessageText\n// ('' — сообщение не меняем). Логика — копия callback_reply из backend/app/bot_replies.py.\nconst prev = $('Кнопка: разбор').first().json;\nconst r = $input.first().json;\n\nlet alert;\nlet edit = '';\nif (prev.action === 'unknown') {\n  alert = 'Кнопка не распознана, напишите заказ текстом';\n} else if (r && r.status === 'confirmed') {\n  alert = 'Принято';\n  edit = 'Заказ №' + r.id + ' подтверждён, ждите звонка.';\n} else if (r && r.status === 'cancelled') {\n  alert = 'Готово';\n  edit = 'Заказ №' + r.id + ' отменён. Напишите новый в любой момент.';\n} else {\n  alert = 'Не получилось, попробуйте ещё раз или напишите в чат';\n}\n\nreturn [{ json: {\n  cbq_id: prev.cbq_id,\n  chat_id: prev.chat_id,\n  message_id: prev.message_id,\n  alert,\n  edit,\n} }];"
